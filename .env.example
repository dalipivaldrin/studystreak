# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=studystreak

# Session Secret - beliebige lange Zufallszeichenkette (mind. 32 Zeichen)
# Generieren mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=changeme_use_a_long_random_string_here
